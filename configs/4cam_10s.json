{
  "schema": "futsalmot_dataset_task",
  "version": 2,
  "task_id": "4cam_10s",
  "episode_name": "episode_4cam_10s",

  "dataset_root": "G:/FutsalMOT_Dataset",
  "ue_project_root": "D:/projects/FustalMOT_UEDataset",

  "export": {
    "scenario": "5_vs_5",
    "seed": 42,
    "num_steps": 100,
    "target_fps": 30,
    "playback_fps": 30,
    "field_length_m": 40.0,
    "field_width_m": 20.0,
    "render": false,
    "write_video": false,
    "dump_full_raw_observation": false,
    "game_duration": 10000,
    "left_team_difficulty": 0.3,
    "right_team_difficulty": 0.3
  },

  "ue": {
    "actor_mapping": "ue/actor_mapping.example.json",
    "sequence_package_path": "/Game/FutsalMOT/Sequences",
    "sequences": [
      { "name": "LS_Cam_01", "camera_actor": "CineCam_01" },
      { "name": "LS_Cam_02", "camera_actor": "CineCam_02" },
      { "name": "LS_Cam_03", "camera_actor": "CineCam_03" },
      { "name": "LS_Cam_04", "camera_actor": "CineCam_04" }
    ],
    "replace_existing": true,
    "ball_rolling": {
      "enabled": true,
      "radius_m": 0.11,
      "minimum_move_distance_m": 0.0001,
      "roll_sign": 1.0
    },
    "annotation_export": {
      "enabled": true,
      "image_width": 1920,
      "image_height": 1080,
      "cameras": ["CineCam_01", "CineCam_02", "CineCam_03", "CineCam_04"],
      "frame_start": 0,
      "frame_end": null,
      "export_internal_jsonl": true,
      "export_mot": true,
      "include_ball": false,
      "mot_visibility_mode": "unoccluded",
      "ball_scale": null,
      "ball_radius_m": 0.11,
      "player_bbox": {
        "source": "capsule",
        "width_scale": 0.7,
        "height_scale": 1.0
      },
      "render_rgb": {
        "enabled": true,
        "preset": "cv_gt",
        "cv_gt": {
          "motion_blur": false,
          "depth_of_field": false,
          "chromatic_aberration": false,
          "lens_distortion": false,
          "anti_aliasing": "taa",
          "temporal_sampling": false
        },
        "output_resolution_x": 1920,
        "output_resolution_y": 1080,
        "frame_rate": 30,
        "file_name_format": "{frame_number}",
        "zero_pad_frame_numbers": 6
      },
      "instance_mask": {
        "enabled": true,
        "mask_source": "object_id_pass",
        "mask_channel": "r",
        "id_scale": 1.0,
        "id_offset": 0.0,
        "background_value": 0,
        "polygon_tolerance_px": 1.0,
        "max_polygon_points": 64,
        "post_process_material": null
      }
    }
  },

  "postprocess": {
    "include_ball": true,
    "workers": 4,
    "chunk_size": 50,
    "png_compress_level": 1,
    "formats": ["json", "mot", "yolo-det", "yolo-seg"],
    "clean_stale": true,
    "validation_level": "full",
    "yolo_pose": {
      "enabled": true,
      "visibility_neighborhood_radius": 2,
      "write_dataset_yaml": true,
      "occlusion_trace": false,
      "trace_tolerance_cm": 20.0,
      "bone_overrides": {},
      "head_offsets_cm": {}
    },
    "debug": {
      "enabled": true,
      "include_ball": false,
      "make_videos": true,
      "pose_dot_radius": 3,
      "pose_edge_width": 3
    }
  },

  "audit": {
    "expected_cameras": 4,
    "expected_frames_per_camera": 300
  }
}